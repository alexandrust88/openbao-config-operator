{
  "gcp-prod/static-account/ci-deployer": {
    "service_account_email": "ci-deployer@example-project.iam.gserviceaccount.com",
    "service_account_project": "example-project",
    "secret_type": "access_token",
    "token_scopes": ["https://www.googleapis.com/auth/devstorage.read_only", "https://www.googleapis.com/auth/cloud-platform"],
    "bindings": {
      "//cloudresourcemanager.googleapis.com/projects/example-project": ["roles/storage.objectViewer"]
    }
  }
}
