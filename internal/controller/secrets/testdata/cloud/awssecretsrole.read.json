{
  "aws-prod/roles/deploy": {
    "credential_type": "assumed_role",
    "role_arns": ["arn:aws:iam::123456789012:role/obco-a", "arn:aws:iam::123456789012:role/obco-b"],
    "policy_arns": ["arn:aws:iam::aws:policy/ReadOnlyAccess"],
    "policy_document": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:ListBucket\",\"Resource\":\"*\"}]}",
    "iam_groups": ["obco-readers"],
    "iam_tags": {"team": "platform"},
    "session_tags": {"env": "sandbox"},
    "external_id": "obco-external-id",
    "default_sts_ttl": 900,
    "max_sts_ttl": 3600,
    "user_path": "/obco/",
    "permissions_boundary_arn": "arn:aws:iam::123456789012:policy/obco-boundary",
    "mfa_serial_number": "arn:aws:iam::123456789012:mfa/obco-device"
  }
}
