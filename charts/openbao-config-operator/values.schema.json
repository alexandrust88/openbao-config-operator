{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "objectList": {"type": "array", "items": {"type": "object"}}
  },
  "properties": {
    "global": {"type": "object"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {"type": "boolean"},
        "keep": {"type": "boolean"},
        "annotations": {
          "description": "Extra annotations on every CRD. With keep true, helm.sh/resource-policy is replaced by keep.",
          "type": "object",
          "additionalProperties": {"type": "string"},
          "propertyNames": {"not": {"const": "controller-gen.kubebuilder.io/version"}}
        },
        "labels": {
          "description": "Extra labels on every CRD, besides the chart's own labels.",
          "type": "object",
          "additionalProperties": {"type": "string"},
          "propertyNames": {
            "not": {
              "enum": [
                "helm.sh/chart",
                "app.kubernetes.io/name",
                "app.kubernetes.io/instance",
                "app.kubernetes.io/version",
                "app.kubernetes.io/managed-by"
              ]
            }
          }
        }
      }
    },
    "pluginKinds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string"}}
      }
    },
    "replicas": {"type": "integer", "minimum": 0},
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "watchNamespaces": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}
    },
    "apiServerAudiences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "^[^,]+$"}
    },
    "injectedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectedToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "audience": {"type": "string", "minLength": 1},
            "expirationSeconds": {"type": "integer", "minimum": 600},
            "path": {"type": "string", "pattern": "^(/[^/]+){2,}$", "maxLength": 512}
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"}
      },
      "if": {"properties": {"create": {"const": false}}, "required": ["create"]},
      "then": {"properties": {"name": {"minLength": 1}}, "required": ["name"]}
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "userRoles": {"type": "boolean"},
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "admin": {"type": "boolean"},
            "edit": {"type": "boolean"},
            "view": {"type": "boolean"}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"$ref": "#/definitions/port"},
        "certSecret": {"type": "string"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["ClusterIP"]},
            "annotations": {"$ref": "#/definitions/stringMap"}
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "interval": {"type": "string"},
        "scrapeTimeout": {"type": "string"},
        "tlsConfig": {"type": "object"},
        "relabelings": {"$ref": "#/definitions/objectList"},
        "metricRelabelings": {"$ref": "#/definitions/objectList"}
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "selector": {"type": "string"},
        "alertLabels": {"$ref": "#/definitions/stringMap"},
        "disabledAlerts": {
          "type": "array",
          "items": {
            "enum": [
              "OpenBaoConfigOperatorDown",
              "OpenBaoConfigOperatorReconcileErrors",
              "OpenBaoConfigOperatorSteadyStateWrites",
              "OpenBaoConfigOperatorOpenBaoServerErrors",
              "OpenBaoConfigOperatorOpenBaoDenied"
            ]
          }
        },
        "reconcileErrorRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "openbaoErrorRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "steadyStateWritesFor": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
        "runbookBaseURL": {"type": "string", "pattern": "^https?://"}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"port": {"$ref": "#/definitions/port"}}
    },
    "pprof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"$ref": "#/definitions/port"}
      }
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {"pattern": "^--?(leader-elect|metrics-secure|metrics-bind-address|pprof-bind-address|health-probe-bind-address)(=|$)"}
      }
    },
    "extraEnv": {"$ref": "#/definitions/objectList"},
    "extraVolumes": {
      "type": "array",
      "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mountPath"],
        "properties": {"name": {"type": "string", "minLength": 1}, "mountPath": {"type": "string", "pattern": "^/"}}
      }
    },
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]},
        "maxUnavailable": {"type": ["integer", "string"]}
      }
    },
    "topologySpreadConstraints": {"$ref": "#/definitions/objectList"},
    "priorityClassName": {"type": "string"},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {"$ref": "#/definitions/objectList"},
    "affinity": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "revisionHistoryLimit": {"type": "integer", "minimum": 0},
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "podLabels": {"$ref": "#/definitions/stringMap"},
    "annotations": {"$ref": "#/definitions/stringMap"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "flavor": {"enum": ["kubernetes", "cilium"]},
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monitoringNamespace": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$", "maxLength": 63},
            "from": {"$ref": "#/definitions/objectList"}
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "to": {"$ref": "#/definitions/objectList"},
            "nodeLocalDNS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "address": {"type": "string", "format": "ipv4"}
              }
            }
          }
        },
        "apiServer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {"type": "array", "items": {"type": "string"}},
            "ports": {"type": "array", "items": {"$ref": "#/definitions/port"}}
          }
        },
        "openbao": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "to": {"$ref": "#/definitions/objectList"},
            "fqdns": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "ports": {"type": "array", "items": {"$ref": "#/definitions/port"}}
          }
        },
        "extraEgress": {"$ref": "#/definitions/objectList"}
      }
    }
  }
}
